{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File-only V3/V9 command v1",
  "description": "All times are in a single replay_monotonic domain. This is not the live v9-planner-command-v1 topic schema. Runtime additionally checks session enrollment, sequence/token/shot reuse, expiry and scheduler state before applying.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session",
    "sequence",
    "shot",
    "token",
    "robot",
    "kind",
    "target_y",
    "issued_at",
    "expires_at",
    "hit"
  ],
  "properties": {
    "schema": {
      "const": "yichao-v3-v9-command-v1"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "shot": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "robot": {
      "enum": [
        "66",
        "198"
      ]
    },
    "kind": {
      "enum": [
        "move",
        "clear",
        "return",
        "hit"
      ]
    },
    "target_y": {
      "type": "number",
      "minimum": -1.2,
      "maximum": 1.2
    },
    "issued_at": {
      "type": "number"
    },
    "expires_at": {
      "type": "number"
    },
    "hit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/hit"
        }
      ]
    },
    "return_y": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1.2,
      "maximum": 1.2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hit"
          }
        }
      },
      "then": {
        "properties": {
          "hit": {
            "$ref": "#/$defs/hit"
          }
        }
      },
      "else": {
        "properties": {
          "hit": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "xyz": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "racket_velocity",
        "ball_velocity",
        "tts",
        "outward_y",
        "return_y"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/xyz"
        },
        "racket_velocity": {
          "$ref": "#/$defs/xyz"
        },
        "ball_velocity": {
          "$ref": "#/$defs/xyz"
        },
        "tts": {
          "type": "number",
          "minimum": 0.12,
          "maximum": 0.55
        },
        "outward_y": {
          "type": "number",
          "minimum": -1.2,
          "maximum": 1.2
        },
        "return_y": {
          "type": "number",
          "minimum": -1.2,
          "maximum": 1.2
        }
      }
    }
  }
}
